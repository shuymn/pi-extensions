{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "lefthook install",
    "lint": "bunx biome lint .",
    "lint:fix": "bunx biome lint --fix .",
    "fmt:fix": "bunx biome format --write .",
    "fmt:check": "bunx biome format .",
    "typecheck": "bunx tsc --noEmit",
    "test": "find . -name '*.test.ts' -not -path './node_modules/*' -print0 | xargs -0 -n1 bun test",
    "check:fast": "bun run fmt:check && bun run lint && bun run typecheck",
    "check": "bun run check:fast && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@earendil-works/pi-ai": "0.75.3",
    "@earendil-works/pi-coding-agent": "0.75.3",
    "@earendil-works/pi-tui": "0.75.3",
    "@types/bun": "1.3.14",
    "@types/node": "^24.3.0",
    "lefthook": "2.1.8",
    "typebox": "^1.1.38",
    "typescript": "6.0.3"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
